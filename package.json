{
  "name": "@severian-dev/avalon-ui",
  "version": "0.4.0",
  "description": "Shared UI components, types, and theme for Avalon projects",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./theme": "./dist/theme/index.css",
    "./stage": {
      "types": "./dist/stage.d.ts",
      "import": "./dist/stage.js",
      "require": "./dist/stage.cjs"
    },
    "./stage.css": "./dist/theme/stage.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run prepend-use-client && npm run copy-css",
    "prepend-use-client": "node scripts/prepend-use-client.mjs",
    "copy-css": "mkdir -p dist/theme && cp src/theme/index.css src/theme/stage.css dist/theme/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/stage/landing.test.ts"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.0.0",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/from-avalon/avalon-ui.git"
  }
}
